{
  "name": "dark-kitchen",
  "version": "0.1.0",
  "description": "Autonomous coding agent control plane — connects trackers, git, coding agents, and human channels",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "dark-kitchen": "./dist/cli.js",
    "dk": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build && node bundle.mjs",
    "bundle": "node bundle.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "agent",
    "autonomous",
    "coding",
    "control-plane",
    "dark-kitchen"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "js-yaml": "4.1.0"
  }
}
