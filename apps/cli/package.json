{
  "name": "dark-kitchen",
  "version": "0.2.0",
  "description": "Autonomous coding agent control plane — connects trackers, git, coding agents, and human channels",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "dark-kitchen": "./dist/cli.js",
    "dk": "./dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc --build && node bundle.mjs",
    "bundle": "node bundle.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "agent",
    "autonomous",
    "coding",
    "control-plane",
    "dark-kitchen"
  ],
  "license": "MIT",
  "devDependencies": {
    "@dark-kitchen/capabilities": "workspace:*",
    "@dark-kitchen/channels": "workspace:*",
    "@dark-kitchen/config": "workspace:*",
    "@dark-kitchen/core": "workspace:*",
    "@dark-kitchen/harness": "workspace:*",
    "@dark-kitchen/harness-deepseek": "workspace:*",
    "@dark-kitchen/mcp": "workspace:*",
    "@dark-kitchen/runtime": "workspace:*",
    "@dark-kitchen/runtime-store-sqlite": "workspace:*",
    "@dark-kitchen/scm": "workspace:*",
    "@dark-kitchen/tracker": "workspace:*",
    "@dark-kitchen/verification": "workspace:*",
    "@dark-kitchen/workflow-engine": "workspace:*",
    "@dark-kitchen/workflows": "workspace:*",
    "@dark-kitchen/workspace-manager": "workspace:*",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "acpx": "0.13.1",
    "grammy": "1.45.1",
    "jiti": "2.7.0",
    "qrcode": "1.5.4",
    "unified-channel": "0.2.0",
    "ws": "8.21.3",
    "yaml": "2.9.0"
  },
  "peerDependencies": {
    "@slack/bolt": "3.22.0",
    "discord.js": "14.27.0",
    "whatsapp-web.js": "^1.34.7"
  },
  "peerDependenciesMeta": {
    "@slack/bolt": {
      "optional": true
    },
    "discord.js": {
      "optional": true
    },
    "whatsapp-web.js": {
      "optional": true
    }
  }
