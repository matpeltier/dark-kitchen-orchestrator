<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.dark-kitchen.daemon</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/dark-kitchen</string>
    <string>start</string>
    <string>--foreground</string>
    <string>--json</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/you/Projects/my-project</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_ENV</key>
    <string>production</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>/Users/you/Library/Logs/dark-kitchen.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/you/Library/Logs/dark-kitchen.error.log</string>
</dict>
</plist>
