[Unit]
Description=Dark Kitchen autonomous software control plane
Documentation=https://github.com/matpeltier/dark-kitchen-orchestrator
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=dark-kitchen
Group=dark-kitchen
WorkingDirectory=/srv/my-project
EnvironmentFile=/etc/dark-kitchen/my-project.env
Environment=NODE_ENV=production
Environment=HOME=/var/lib/dark-kitchen
ExecStart=/usr/local/bin/dark-kitchen start --foreground --json
ExecStop=/bin/kill -TERM $MAINPID
Restart=on-failure
RestartSec=10s
TimeoutStopSec=45s
KillSignal=SIGTERM
UMask=0077

# The daemon, Git, harnesses, and managed providers may write only here.
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/my-project /var/lib/dark-kitchen
StateDirectory=dark-kitchen
PrivateTmp=true
NoNewPrivileges=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
