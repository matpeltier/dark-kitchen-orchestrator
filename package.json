{
  "name": "dark-kitchen-orchestrator",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "typecheck": "tsc --build",
    "test": "vitest run",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "build": "tsc --build",
    "validate:packages": "node scripts/validate-packages.mjs",
    "validate": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm validate:packages"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "22.10.5",
    "eslint": "9.17.0",
    "globals": "15.14.0",
    "prettier": "3.4.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.19.1",
    "vitest": "2.1.8"
  }
}
